# 复制为 .env 后按需修改；.env 已被 Git 忽略。

# 核心服务
NODE_ENV=development
PORT=4173
DATA_FILE=data/evaluations.json
ALLOW_PRIVATE_AGENT_URLS=false

# OpenAI-compatible 多模型评审网关
OPENAI_BASE_URL=https://llmx.tqx.ai/v1
OPENAI_API_KEY=

# 三位评审可独立指定模型。网关可用代码：
# OpenAI: g4o, g4om, g5, g5m, g5.1, g5.2, g5.4, g5.4m, g5.4n
# OSS/NV: nems-120, oss-120, oss-20
# Google: gm3-27
# Anthropic: ch4.5, cs4.5, cs4.6, claude-sonnet-4-5
# DeepSeek: dkc, dsr
# xAI Grok: gk4, gk4f, gk4fr
REVIEW_MODEL_OPENAI=g5.4
REVIEW_MODEL_ANTHROPIC=cs4.6
REVIEW_MODEL_DEEPSEEK=dkc

# 模型评审与 Runtime adapter（JSON 必须保持在单行）
# MODEL_REVIEWERS_JSON 非空时优先于上面的网关快捷配置。
MODEL_REVIEWERS_JSON=
RUNTIME_ADAPTERS_JSON={}

# 本机 CLI Runtime
ENABLE_LOCAL_CLAUDE_CODE=false
ENABLE_LOCAL_CURSOR_AGENT=false
CLAUDE_MAX_BUDGET_USD=0.25
LOCAL_RUNTIME_TIMEOUT_MS=180000

# DeepSeek 驱动 Claude Code（只在本地 .env 填写真实 Key）
DEEPSEEK_API_KEY=
DEEPSEEK_CLAUDE_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash
CLAUDE_CODE_SUBAGENT_MODEL=deepseek-v4-flash
CLAUDE_CODE_EFFORT_LEVEL=max

# 可在启动进程中设置 ENV_FILE=/absolute/path/to/custom.env 来加载其他文件。
