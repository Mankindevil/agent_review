# 复制为 .env 后按需修改；.env 已被 Git 忽略。

# 核心服务
NODE_ENV=development
PORT=4173
DATA_FILE=data/evaluations.json
ALLOW_PRIVATE_AGENT_URLS=false

# 一次性 Agent 协议检查台
# 保护 /api/agent-diagnostics；必须设置后诊断 API 才会开放。
AGENT_DIAGNOSTICS_ACCESS_KEY=
AGENT_DIAGNOSTICS_RATE_LIMIT=6
AGENT_DIAGNOSTICS_CONCURRENCY=4

# PandaAI Quant 金融数据源（官方 panda_data Python SDK）
# 安装：python3 -m venv .venv && .venv/bin/python -m pip install -r requirements-data.txt
# username 可填 11 位手机号或 86 开头账号；真实密码只写本机 .env，不要提交。
PANDA_DATA_ENABLED=false
PANDA_DATA_AUTO_VERIFY=false
PANDA_DATA_USERNAME=
PANDA_DATA_PASSWORD=
PANDA_DATA_BASE_URL=http://pandadata.pandaaiquant.com
# 保护 /api/data-source/query 的独立 Bearer Key；留空时查询网关保持关闭。
PANDA_DATA_ACCESS_KEY=
PANDA_DATA_PYTHON=.venv/bin/python
PANDA_DATA_TIMEOUT_MS=60000
PANDA_DATA_MAX_ROWS=500
PANDA_DATA_ALLOWED_METHODS=get_trade_cal,get_prev_trade_date,get_last_trade_date,get_trade_list,get_stock_status_change,get_stock_daily,get_stock_daily_pre,get_stock_daily_post,get_index_daily,get_index_weights,get_factor,get_adj_factor,get_fina_reports,get_stock_disclosure_date,get_stock_industry,get_industry_constituents,get_hk_daily,get_us_daily

# OpenAI-compatible 多模型评审网关
OPENAI_BASE_URL=https://llmx.tqx.ai/v1
OPENAI_API_KEY=

# LLMX 两位评审可独立指定模型。网关可用代码：
# OpenAI: g4o, g4om, g5, g5m, g5.1, g5.2, g5.4, g5.4m, g5.4n
# OSS/NV: nems-120, oss-120, oss-20
# Google: gm3-27
# Anthropic: ch4.5, cs4.5, cs4.6, claude-sonnet-4-5
# DeepSeek: dkc, dsr
# xAI Grok: gk4, gk4f, gk4fr
REVIEW_MODEL_OPENAI=g5.4
REVIEW_MODEL_ANTHROPIC=cs4.6

# 火山方舟在线推理：豆包和 DeepSeek 共用 Key，模型值为接入点 ID。
# 官方 OpenAI-compatible Base URL 必须包含 /api/v3。
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
REVIEW_MODEL_DOUBAO=ep-20260720110725-5rbml
REVIEW_MODEL_DEEPSEEK=ep-20260708162855-pcf9x
MODEL_REVIEW_TIMEOUT_MS=180000
MODEL_REVIEW_MAX_TOKENS=1200
# 相同 seed + temperature=0 会让支持 seed 的模型调用尽量可复现。
EVALUATION_SEED=20260720
MODEL_TEMPERATURE=0

# 模型评审与 Runtime adapter（JSON 必须保持在单行）
# MODEL_REVIEWERS_JSON 非空时优先于上面的网关快捷配置。
MODEL_REVIEWERS_JSON=
RUNTIME_ADAPTERS_JSON={}

# 本机 CLI Runtime
# 生产工具目录由 root 管理；不要指向用户可写目录。
# PATH=/opt/agent-review/tools/bin:/usr/local/bin:/usr/bin:/bin
ENABLE_LOCAL_CLAUDE_CODE=false
ENABLE_LOCAL_CURSOR_AGENT=false
# Cursor Agent 使用专用、持久的文件凭据目录；CLI 运行时不会继承任何 API Key。
# 生产目录应只允许 agent-review 服务账户访问。
CURSOR_AUTH_CONFIG_HOME=/var/lib/agent-review/cursor-auth
CLAUDE_MAX_BUDGET_USD=0.25
LOCAL_RUNTIME_TIMEOUT_MS=180000
RUNTIME_PROBE_TIMEOUT_MS=30000

# DeepSeek 驱动 Claude Code（只在本地 .env 填写真实 Key）
# ark：通过本地协议桥使用上面的方舟 DeepSeek endpoint；deepseek：直连 DeepSeek Anthropic API。
# 仅支持这两个显式值；所选后端配置不完整时失败关闭，不会使用另一后端的凭据。
CLAUDE_BACKEND=ark
CLAUDE_ARK_MODEL=ep-20260708162855-pcf9x
DEEPSEEK_API_KEY=
DEEPSEEK_CLAUDE_MODEL=deepseek-v4-pro[1m]
# 仅供 MODEL_REVIEWERS_JSON / RUNTIME_ADAPTERS_JSON 显式引用；本地 Claude Runtime 不继承。
ANTHROPIC_API_KEY=
CLAUDE_CODE_EFFORT_LEVEL=max

# 可在启动进程中设置 ENV_FILE=/absolute/path/to/custom.env 来加载其他文件。
# 可设置 ENV_FALLBACK_FILE 作为共享基础配置；当前分支 .env 中的同名变量优先。
ENV_FALLBACK_FILE=
