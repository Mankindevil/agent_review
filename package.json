{
  "name": "agent-roast-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "金融 A2A Agent 研究严谨性、数据纪律与同题基准对测平台",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "agents": "node examples/agents/server.js",
    "demo:real": "node scripts/real-demo.js",
    "demo:real-runtimes": "ENABLE_LOCAL_CLAUDE_CODE=true ENABLE_LOCAL_CURSOR_AGENT=true node scripts/real-demo.js",
    "demo:deepseek": "node scripts/deepseek-demo.js",
    "data:probe": ".venv/bin/python scripts/panda-data-bridge.py --probe",
    "market-agent": "node agents/market-analyst/server.js",
    "market-report": "node agents/market-analyst/cli.js",
    "market:smoke": "node scripts/market-agent-live-smoke.js",
    "bundle:agent-check": "node scripts/build-agent-check-bundles.js",
    "test": "node scripts/run-tests.js && node scripts/run-market-worker-tests.js",
    "test:node": "node scripts/run-tests.js",
    "test:market-worker": "node scripts/run-market-worker-tests.js",
    "check": "node scripts/check-syntax.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "nodemailer": "^9.0.3"
  }
}
